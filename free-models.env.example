# Copy these exports into your shell profile only after verifying that the
# named model is currently free on the provider/account you use.
# Leave variables unset to use local Ollama only.

# Groq: exact model ID for your free account.
# export GROQ_API_KEY=...
# export FLOSSWARE_GROQ_MODEL=...

# Cerebras: exact model ID for your free account.
# export CEREBRAS_API_KEY=...
# export FLOSSWARE_CEREBRAS_MODEL=...

# OpenRouter: comma-separated model IDs that are explicitly marked :free.
# export OPENROUTER_API_KEY=...
# export FLOSSWARE_OPENROUTER_FREE_MODELS=provider/model:free,provider/another-model:free

# GitHub MCP uses your existing gh authentication automatically when available.
# An explicit token can be supplied instead:
# export GH_PAT=...
